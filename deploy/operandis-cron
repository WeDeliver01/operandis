# /etc/cron.d/operandis — maintenance jobs and nightly backup for Operandis on web01.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Email outbox, expire abandoned checkouts/proposals, delete expired configurator drafts
*/5 * * * * root docker exec operandis node dist/jobs.mjs >> /var/log/operandis-jobs.log 2>&1
# Nightly database backup (keeps the newest 30 dumps in /srv/backups/operandis)
20 2 * * * root /srv/operandis/deploy/deploy.sh --backup >> /var/log/operandis-backup.log 2>&1
