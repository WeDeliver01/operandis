# /srv/operandis/operandis.env — production environment (chmod 600, owned by operandis).
# NEVER commit the real file. See docs/environment.md for every variable.
NODE_ENV=production
API_PORT=8080
TRUST_PROXY=loopback
PUBLIC_WEB_URL=https://operandis.co.za
SERVE_WEB_DIST=/srv/operandis/app/artifacts/operandi/dist/public

# Created by the install steps in docs/vps-deployment.md
DATABASE_URL=postgres://operandis:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/operandis

# Generate with: openssl rand -base64 48
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Email (transactional provider SMTP relay with a verified operandis.co.za sending domain)
EMAIL_DRIVER=smtp
EMAIL_FROM="Operandis <hello@operandis.co.za>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Private file storage on this server (included in backups)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/srv/operandis/files

# PayFast — start with sandbox credentials, switch to live after a test transaction
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_VERIFY_SOURCE_IP=true

# Yoco (optional)
# YOCO_SECRET_KEY=
# YOCO_WEBHOOK_SECRET=
