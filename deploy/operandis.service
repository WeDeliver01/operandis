# /etc/systemd/system/operandis.service
[Unit]
Description=Operandis platform (API + website)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=operandis
Group=operandis
WorkingDirectory=/srv/operandis/app/artifacts/api-server
EnvironmentFile=/srv/operandis/operandis.env
ExecStart=/usr/bin/node --enable-source-maps dist/index.mjs
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/operandis/files

[Install]
WantedBy=multi-user.target
