# deploy/.env.production — copy from this file on the server, then fill in. NEVER commit it.
# Format: KEY=value, one per line. Quote values containing spaces or special characters.
# Comments go on their own line (not after a value).

# ---- Required -------------------------------------------------------------
PUBLIC_WEB_URL=https://operandis.co.za
# Host port the container listens on (127.0.0.1 only). Must be free on web01
# and match proxy_pass in /etc/nginx/sites-available/operandis.co.za. AirHouse uses 5000.
APP_PORT=5100
# Password for the private Postgres container. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs links and encrypts MFA secrets. Generate: openssl rand -base64 48
APP_SECRET=

# ---- Email (required in production) ---------------------------------------
# Any SMTP relay with operandis.co.za verified (SPF/DKIM/DMARC). Examples:
#   Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASSWORD=<API key>
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<login> SMTP_PASSWORD=<SMTP key>
EMAIL_DRIVER=smtp
EMAIL_FROM="Operandis <hello@operandis.co.za>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Payments (optional at first; EFT works without them) -----------------
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_VERIFY_SOURCE_IP=true
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# ---- Optional ----------------------------------------------------------------
LOG_LEVEL=info
