# /etc/systemd/system/operandis-jobs.service — one-shot maintenance (emails, expiries, draft cleanup)
[Unit]
Description=Operandis maintenance jobs
After=postgresql.service

[Service]
Type=oneshot
User=operandis
Group=operandis
WorkingDirectory=/srv/operandis/app/artifacts/api-server
EnvironmentFile=/srv/operandis/operandis.env
ExecStart=/usr/bin/node dist/jobs.mjs
