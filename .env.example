# ---------------------------------------------------------------------------
# Operandis — local development environment. Copy to .env and adjust.
# NEVER commit .env. Server secrets must never be given a VITE_ prefix.
# See docs/environment.md for every variable and production guidance.
# ---------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://operandis:operandis@localhost:5432/operandis
API_PORT=5000
PUBLIC_WEB_URL=http://localhost:5173
# Generate with: openssl rand -base64 48
APP_SECRET=dev-secret-change-me-dev-secret-change-me-0000
LOG_LEVEL=info

# Email: "log" captures emails in memory (GET /api/v1/dev/outbox in development); use "smtp" in production.
EMAIL_DRIVER=log
EMAIL_FROM="Operandis <hello@operandis.co.za>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Files: "local" stores under STORAGE_LOCAL_DIR; use "s3" (any S3-compatible store) in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/files

# PayFast sandbox (public test merchant from PayFast's documentation). Replace for production.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
# ITNs cannot reach localhost; expose the API with a tunnel and set PUBLIC_API_URL to receive them.
# PUBLIC_API_URL=https://your-tunnel.example
PAYFAST_SKIP_REMOTE_VALIDATION=false

# Yoco (optional)
# YOCO_SECRET_KEY=
# YOCO_WEBHOOK_SECRET=
