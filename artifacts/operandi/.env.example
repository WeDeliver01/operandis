# Marketing tag IDs. Loaded only after the matching consent category is granted
# via the cookie banner. Leave blank or unset to disable that tag.

# Google Analytics 4 — Measurement ID (looks like G-XXXXXXXXXX)
VITE_GA4_ID=

# Google Ads — Conversion ID (looks like AW-XXXXXXXXXX)
VITE_GOOGLE_ADS_ID=

# Meta (Facebook / Instagram) Pixel ID — 15-16 digit numeric ID
VITE_META_PIXEL_ID=

# LinkedIn Insight Tag — Partner ID (numeric)
VITE_LINKEDIN_PARTNER_ID=
