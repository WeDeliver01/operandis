{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts --demo",
    "create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts",
    "openapi": "tsx src/scripts/openapi.ts",
    "jobs": "tsx --env-file-if-exists=../../.env src/scripts/jobs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/domain": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "yaml": "^2.8.1",
    "zod": "catalog:",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.27.3",
    "supertest": "^7.1.4",
    "tsx": "catalog:",
    "vitest": "^4.1.12"
  }
}